{
  "name": "chatgpt-weight-tracker",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "pnpm --filter @weight-tracker/web dev",
    "build": "pnpm --filter @weight-tracker/web build",
    "start": "pnpm --filter @weight-tracker/web start",
    "boundaries": "tsx scripts/check-boundaries.ts",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck && tsc --project tsconfig.test.json",
    "test": "tsx --conditions=react-server --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "test:build-security": "tsx scripts/check-client-bundles.ts",
    "check": "pnpm boundaries && pnpm lint && pnpm typecheck && pnpm test && pnpm test:build-security && pnpm test:e2e"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.3.14",
    "@eslint/js": "10.0.1",
    "@modelcontextprotocol/client": "2.4.0",
    "@next/eslint-plugin-next": "16.4.5",
    "@playwright/test": "1.65.0",
    "@supabase/supabase-js": "2.119.0",
    "@types/node": "24.10.0",
    "@weight-tracker/auth": "workspace:*",
    "@weight-tracker/config": "workspace:*",
    "@weight-tracker/contracts": "workspace:*",
    "@weight-tracker/db": "workspace:*",
    "@weight-tracker/domain": "workspace:*",
    "@weight-tracker/mcp": "workspace:*",
    "eslint": "10.14.0",
    "jose": "6.2.15",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1"
  }
}
